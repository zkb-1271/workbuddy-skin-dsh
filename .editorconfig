# 统一编辑器行为，避免 PR 里混入「整文件缩进变化」这类无意义 diff。
# 编辑器需要装 EditorConfig 插件才会生效（VS Code / JetBrains 多数自带或可一键安装）。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# shell 脚本：2 空格缩进（不用 tab，方便和 JS 混看）
[*.sh]
indent_size = 2

# Markdown：行尾两个空格是有意义的硬换行，不要自动删
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
